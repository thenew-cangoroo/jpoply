# Leave empty for local demo mode during npm run dev.
# Set to firestore for the hosted site.
JPLY_STORAGE=

# Firebase mode
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
JPLY_ADMIN_UID=

# Optional. Change the local demo credentials on your own computer.
JPLY_LOCAL_ADMIN_EMAIL=
JPLY_LOCAL_ADMIN_PASSWORD=
JPLY_LOCAL_SESSION_SECRET=
